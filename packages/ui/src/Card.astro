---
/**
 * Card — pen master `I2gPrr`.
 * context: div · Card — surface shell with slot
 *
 * The generic surface: 14px radius, `--a-line` border, 16px padding, 8px gap.
 * The pen master is 260 wide; here the caller sizes it, since no caller wants
 * 260. FeatureCard and ProjectCard do **not** use it — the pen spells their
 * surface out (no padding of its own; the body pads itself).
 */
interface Props {
  class?: string;
  as?: "div" | "li" | "article";
}

const { class: className, as: Tag = "div" } = Astro.props;
---

<Tag class:list={["card", className]}><slot /></Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }
</style>