---
/**
 * ProjectCard — pen master `FE7oC`, the compact card.
 * context: article · ProjectCard ← project{title,topic,excerpt}
 *
 *   Preview   96px cover, `gradientFor(seed)`, Monogram 44 `title[0]` at 0.9
 *   Body      padding 14 · gap 7
 *             Tag ← topic · Title 15.5/600 · Desc 12.5/1.4 `$a-muted`
 *
 * Four slots and no tech row: this is the card for the detail screens' related
 * rows (Article — Detail `bRJFE`, Experiments — Detail `vMQY2`). The browse
 * grid uses the richer FeatureCard. The whole card is one link, to a page on
 * this site.
 */
import Tag from "./Tag.astro";
import { gradientFor } from "@badger3000/tokens/covers";

interface Props {
  title: string;
  href: string;
  /** Picks the cover gradient, usually the document id. */
  seed: string;
  topic?: string;
  excerpt?: string;
}

const { title, href, seed, topic, excerpt } = Astro.props;

const monogram = title.trim().charAt(0);
---

<article class="card">
  <div class="pv" style={`background:${gradientFor(seed)}`}>
    <span class="mono" aria-hidden="true">{monogram}</span>
  </div>
  <div class="bd">
    {topic && <Tag label={topic} />}
    <a class="ti" href={href}>{title}</a>
    {excerpt && <p class="desc">{excerpt}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }
  .pv {
    position: relative;
    flex: none;
    height: 96px;
  }
  .mono {
    position: absolute;
    top: 12px;
    left: 14px;
    font-family: var(--af-display);
    font-size: 44px;
    line-height: 1;
    color: var(--a-on-cover);
    opacity: 0.9;
  }
  .bd {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 14px;
  }
  .ti {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--a-ink);
    text-decoration: none;
  }
  /* The title link covers the card, so the whole card is the target. */
  .ti::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover .ti {
    color: var(--a-accent-text);
  }
  .ti:focus-visible {
    outline: none;
  }
  .card:has(.ti:focus-visible) {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
  }
  .desc {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--a-muted);
  }
</style>
