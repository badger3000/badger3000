---
/**
 * FilterChip — pen master `RA61q`.
 * context: button · FilterChip — props: label, active ← topics[]
 *
 * Inactive: surface fill, `--a-line-2` border, muted label.
 * Active:   ink fill, ink border, surface label (pen frames RDSip / `All`).
 *
 * A real `<button aria-pressed>` so the filter state is announced; the page's
 * script wires the clicks.
 */
interface Props {
  label: string;
  active?: boolean;
  /** Value the filter applies, e.g. a topic slug. */
  value?: string;
}

const { label, active = false, value } = Astro.props;
---

<button
  type="button"
  class="chip"
  data-filter-chip={value ?? label}
  aria-pressed={active ? "true" : "false"}
>
  {label}
</button>

<style>
  .chip {
    padding: 7px 13px;
    border: 1px solid var(--a-line-2);
    border-radius: 18px;
    background: var(--a-surface);
    color: var(--a-muted);
    font-family: var(--af-ui), ui-sans-serif, system-ui, sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .chip:hover {
    color: var(--a-ink);
  }
  .chip[aria-pressed="true"] {
    border-color: var(--a-ink);
    background: var(--a-ink);
    color: var(--a-surface);
  }
</style>