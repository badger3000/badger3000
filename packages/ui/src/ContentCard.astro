---
/**
 * ContentCard — the shared card behind ArticleCard and ExperimentCard.
 *
 * The pen draws two nearly identical cards (Browse — Articles: `img` 116 + `bd`
 * padding 14 gap 6; Browse — Experiments: `pv` 132 + `bd` the same), differing in
 * the cover treatment and the title size. They share everything else, so this
 * holds the shared half and the two wrappers pass the differences.
 *
 *   surface · radius 14 · bd padding 14, gap 6
 *   title 15.5/600 `$a-ink` · excerpt 13 `$a-muted`
 *   meta: date · read, 11 `$a-faint`, padding-top 2
 */
import Tag from "./Tag.astro";
import { gradientFor } from "@badger3000/tokens/covers";

interface Props {
  /** Picks the cover gradient, usually the document id. */
  seed: string;
  href: string;
  title: string;
  excerpt?: string;
  topic?: string;
  /** Date line, e.g. "Feb 2025 · 8 min". */
  meta?: string;
  /** Cover height: 116 for articles, 132 for experiments. */
  coverHeight?: number;
  titleSize?: number;
  /** Experiments use a dark window cover instead of the gradient. */
  cover?: "gradient" | "window";
}

const { seed, href, title, excerpt, topic, meta, coverHeight = 116, titleSize = 15.5, cover = "gradient" } =
  Astro.props;
---

<article class="card">
  <div class="cover" style={`height:${coverHeight}px;${cover === "gradient" ? `background:${gradientFor(seed)}` : ""}`}>
    {
      cover === "window" && (
        <div class="window" aria-hidden="true">
          <span class="dots"><i /><i /><i /></span>
          <span class="lines"><b /><b /><b /></span>
        </div>
      )
    }
  </div>

  <div class="bd">
    {topic && <Tag label={topic} class="tg" />}
    <a class="ti" href={href} style={`font-size:${titleSize}px`}>{title}</a>
    {excerpt && <p class="ex">{excerpt}</p>}
    {meta && <p class="meta">{meta}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }
  .cover {
    flex: none;
  }
  .window {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 7px;
    padding: 12px;
    background: var(--a-cover-window);
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--a-cover-window-dot);
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 6px;
  }
  .lines b {
    height: 5px;
    border-radius: 3px;
    background: var(--a-cover-window-line);
  }
  .lines b:nth-child(2) {
    width: 70%;
  }
  .lines b:nth-child(3) {
    width: 45%;
  }

  .bd {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
  }
  .ti {
    color: var(--a-ink);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }
  .ti:hover {
    color: var(--a-accent);
  }
  .ex {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.45;
    color: var(--a-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .meta {
    margin: 0;
    padding-top: 2px;
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 11px;
    color: var(--a-faint);
  }
</style>