---
/**
 * ContentCard — the shared card behind ArticleCard and ExperimentCard.
 *
 * The pen draws two nearly identical cards (Browse — Articles: `img` 116 + `bd`
 * padding 14 gap 6; Browse — Experiments: `pv` 132 + `bd` the same), differing in
 * the cover treatment and the title size. They share everything else, so this
 * holds the shared half and the two wrappers pass the differences.
 *
 *   surface · radius 14 · bd padding 14, gap 6
 *   title 15.5/600 `$a-ink` · excerpt 13 `$a-muted`
 *   meta: date · read, 11 `$a-subtle`, padding-top 2
 */
import Tag from "./Tag.astro";
import { gradientFor, lineColor, WINDOW_PALETTES } from "@badger3000/tokens/covers";

interface Props {
  /** Picks the cover gradient, usually the document id. */
  seed: string;
  href: string;
  title: string;
  excerpt?: string;
  topic?: string;
  /** Date line, e.g. "Feb 2025 · 8 min". */
  meta?: string;
  /** Cover height: 116 for articles, 132 for experiments. */
  coverHeight?: number;
  titleSize?: number;
  /** Experiments use a dark window cover (colourful code bars) instead of the gradient. */
  cover?: "gradient" | "window";
  /** Heading level of the title: 3 under a section heading, 2 straight under the page's h1. */
  level?: 2 | 3;
}

const {
  seed,
  href,
  title,
  excerpt,
  topic,
  meta,
  coverHeight = 116,
  titleSize = 15.5,
  cover = "gradient",
  level = 3,
} = Astro.props;
const H = `h${level}` as "h2" | "h3";
// The pen's first window (GWZwY) is the server-rendered default. The browser then
// re-rolls palette and widths per visit (apps/web/src/lib/cover-window.ts).
const [la, lb, lc] = WINDOW_PALETTES[0];
const windowStyle = [
  `--l1:${lineColor(la)}`,
  `--l2:${lineColor(lb)}`,
  `--l3:${lineColor(lc)}`,
  "--w1:54%",
  "--w2:76%",
  "--w3:39%",
  "--w4:64%",
].join(";");
---

<article class="card">
  <div class="cover" style={`height:${coverHeight}px;${cover === "gradient" ? `background:${gradientFor(seed)}` : ""}`}>
    {
      cover === "window" && (
        <div class="window" aria-hidden="true" data-cover-window style={windowStyle}>
          <span class="dots">
            <i style="--i:0" />
            <i style="--i:1" />
            <i style="--i:2" />
          </span>
          <span class="lines">
            <b style="--i:0" />
            <b style="--i:1" />
            <b style="--i:2" />
            <b style="--i:3" />
          </span>
        </div>
      )
    }
  </div>

  <div class="bd">
    {topic && <Tag label={topic} class="tg" />}
    <H class="h"><a class="ti" href={href} style={`font-size:${titleSize}px`}>{title}</a></H>
    {excerpt && <p class="ex">{excerpt}</p>}
    {meta && <p class="meta">{meta}</p>}
  </div>
</article>

<style>
  /* The title's heading level is the page's call; the look stays on .ti. */
  .h {
    margin: 0;
    font: inherit;
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }
  .cover {
    flex: none;
  }
  .window {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 7px;
    padding: 12px;
    background: var(--a-cover-window);
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--a-cover-window-dot-1);
  }
  .dots i:nth-child(2) {
    background: var(--a-cover-window-dot-2);
  }
  .dots i:nth-child(3) {
    background: var(--a-cover-window-dot-3);
  }
  /* The pen's four bars alternate three colours: 1 and 4 share the first. */
  .lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 6px;
  }
  .lines b {
    width: var(--w1);
    height: 5px;
    border-radius: 3px;
    background: var(--l1);
    opacity: 0.85;
    transform-origin: left center;
  }
  .lines b:nth-child(2) {
    width: var(--w2);
    background: var(--l2);
  }
  .lines b:nth-child(3) {
    width: var(--w3);
    background: var(--l3);
  }
  .lines b:nth-child(4) {
    width: var(--w4);
  }

  /*
   * Arrival. With scripting on, the window waits hidden until the island marks it
   * in view (no flash of the default before the re-roll); without scripting the
   * default simply shows. `data-done` is the settled state: it outlives the
   * animation so a filter hiding and re-showing the card does not replay it.
   */
  @media (scripting: enabled) {
    .dots i,
    .lines b {
      opacity: 0;
    }
    .window[data-in-view] .dots i {
      animation: window-dot-in var(--duration-fast) var(--ease-smooth-out) both;
      animation-delay: calc(var(--i) * var(--duration-stagger));
    }
    .window[data-in-view] .lines b {
      animation: window-line-draw var(--duration-slow) var(--ease-smooth-out) both;
      animation-delay: calc(var(--duration-fast) + var(--i) * var(--duration-stagger));
    }
    .window[data-done] .dots i,
    .window[data-done] .lines b {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .window[data-done] .lines b {
      opacity: 0.85;
    }
  }
  @media (prefers-reduced-motion: reduce), print {
    .dots i,
    .lines b {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .lines b {
      opacity: 0.85 !important;
    }
  }

  .bd {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
  }
  .ti {
    color: var(--a-ink);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }
  .ti:hover {
    color: var(--a-accent-text);
  }
  .ex {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.45;
    color: var(--a-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .meta {
    margin: 0;
    padding-top: 2px;
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 11px;
    color: var(--a-subtle);
  }
</style>