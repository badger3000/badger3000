---
/**
 * SuggestionChip — pen master `TPq9Z`.
 * context: button · SuggestionChip — props: icon, label, prompt
 *
 *   `$a-surface` · stroke `$a-line-2` · radius 20 · gap 7 · padding [8, 13]
 *   Icon 14 `$a-accent` · Label 13/500 `$a-ink`
 *
 * `prompt` is the question the chip asks. A chip does not navigate or send:
 * it fills the composer on the page (the delegate lives in `lib/shell.ts`), so
 * the visitor can edit the question first. The chat island also clones this
 * as the `suggestions` an answer offers.
 */
import Icon from "./Icon.astro";

interface Props {
  label: string;
  prompt: string;
  icon?: string;
  class?: string;
}

const { label, prompt, icon = "sparkle", class: className } = Astro.props;
---

<button type="button" class:list={["chip", className]} data-suggestion={prompt}>
  <Icon name={icon} size={14} />
  <span data-slot="label">{label}</span>
</button>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border: 1px solid var(--a-line-2);
    border-radius: 20px;
    background: var(--a-surface);
    color: var(--a-ink);
    font-family: var(--af-ui), ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .chip :global(svg) {
    color: var(--a-accent);
  }
  .chip:hover {
    border-color: var(--a-accent);
    color: var(--a-accent-text);
  }
  .chip:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
  }
</style>
