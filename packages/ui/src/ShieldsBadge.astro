---
/**
 * ShieldsBadge — pen master `NjGub`.
 * context: span · ShieldsBadge — props: label,value,color ← skill
 *
 *   stroke `$a-line` · radius 5 · mono 10.5 `$a-on-accent`
 *   Key   `--a-badge-key` padding [4, 8]          ← skill.name
 *   Value fill ← skill.badgeColor, padding [4, 8] ← skill.badgeLabel
 *
 * `value` (badgeLabel) is optional — plenty of skills have only a colour. The
 * pen always draws the Value segment with the skill's colour, so it renders
 * whenever there is a colour: with no label it is an 8px swatch. With neither,
 * the badge is the key alone. The projection has already normalised the colour
 * to `#rrggbb`; it is data, so it arrives as an inline style.
 */
interface Props {
  name: string;
  color?: string;
  value?: string;
  class?: string;
}

const { name, color, value, class: className } = Astro.props;

// The colour is data: it may be missing or malformed (a truncated hex in the
// CMS is dropped by the browser, leaving the neutral fill). Only a valid `#rgb`
// / `#rrggbb` is applied, and the label picks whichever of white / ink reads
// better on it (WCAG relative luminance) rather than assuming white.
const hex = (() => {
  const m = color?.match(/^#?([0-9a-f]{3}|[0-9a-f]{6})$/i);
  if (!m) return undefined;
  const h = m[1].length === 3 ? [...m[1]].map((c) => c + c).join("") : m[1];
  return h.toLowerCase();
})();
const lightFill = (() => {
  if (!hex) return false;
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  const inkLum = 0.0103; // --p-850
  return (lum + 0.05) / (inkLum + 0.05) > 1.05 / (lum + 0.05);
})();
---

<span class:list={["badge", className]}>
  <span class="key">{name}</span>
  {
    (value || hex) && (
      <span class:list={["value", { swatch: !value, onDark: Boolean(hex) && !lightFill, onLight: lightFill }]} style={hex ? `background:#${hex}` : undefined}>
        {value}
      </span>
    )
  }
</span>

<style>
  .badge {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--a-line);
    border-radius: 5px;
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 10.5px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .key,
  .value {
    padding: 4px 8px;
    color: var(--a-on-accent);
  }
  .key {
    background: var(--a-badge-key);
  }
  .value {
    background: var(--a-line-2);
    color: var(--a-ink);
  }
  .onLight {
    color: var(--p-850);
  }
  .onDark {
    color: var(--a-on-accent);
  }
  .swatch {
    width: 8px;
    padding: 0;
  }
</style>
