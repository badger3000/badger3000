                      "children": [
                        {
                          "type": "text",
                          "id": "S5Yhnk",
                          "name": "About",
                          "context": "h2#about-head 'About this pen' display 28",
                          "fill": "$a-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "About this pen",
                          "lineHeight": 1.15,
                          "fontFamily": "$af-display",
                          "fontSize": 28,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "MBwGa",
                          "context": "p ← description (blocks) via PortableBody, 16/1.65",
                          "fill": "$a-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Magnetic buttons is the smallest demo I keep returning to when I want to feel the work of a React hook under my fingers. The motion model is plain — distance from cursor, weighted by an easing curve, clamped to a small radius — but it does the work of teaching you what a good interactive surface feels like.",
                          "lineHeight": 1.65,
                          "fontFamily": "$af-ui",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "MY3Bm",
                          "context": "p ← description (blocks) via PortableBody, 16/1.65",
                          "fill": "$a-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Drop the component anywhere you have a CTA cluster. The hook takes a `strength` prop (0–1) and a `radius` (px). At strength 0 it sits dead still; at strength 1 it chases you around the page. Try .45 for menus, .7 for the hero.",
                          "lineHeight": 1.65,
                          "fontFamily": "$af-ui",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "aoecx",
                          "name": "Quote",
                          "context": "blockquote ← description blockquote style",
                          "width": "fill_container",
                          "padding": [
                            4,
                            24
                          ],
                          "children": [
                            {
                              "type": "frame",
                              "id": "CDuva",
                              "name": "Quote body",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 12,
                              "padding": [
                                4,
                                0
                              ],
                              "children": [
                                {
                                  "type": "rectangle",
                                  "cornerRadius": 2,
                                  "id": "l8qtR7",
                                  "name": "bar",
                                  "fill": "$a-accent",
                                  "width": 3,
                                  "height": 0
                                },
                                {
                                  "type": "text",
                                  "id": "FDZlQ",
                                  "name": "t",
                                  "fill": "$a-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "There's a moment in good interactive UI where the cursor and the button stop being two things. That's the whole job.",
                                  "lineHeight": 1.35,
                                  "fontFamily": "$af-display",
                                  "fontSize": 22,
                                  "fontWeight": "normal",
                                  "fontStyle": "italic"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "D1qsE6",
                          "context": "p ← description (blocks) via PortableBody, 16/1.65",
                          "fill": "$a-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The pen is small on purpose. It's meant to be forked and re-skinned — try it with a 1.2s easing curve and a heavier radius. Or strip the easing entirely and watch the buttons snap. Both will tell you something about how you want your product to feel.",
                          "lineHeight": 1.65,
                          "fontFamily": "$af-ui",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
