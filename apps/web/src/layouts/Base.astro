---
/**
 * Base — the document shell every page uses.
 * Owns <head>, the token and base stylesheets (`@badger3000/tokens`), fonts,
 * the client router, and the pre-paint theme restore. Components never set data-theme themselves; the
 * toggle writes it.
 *
 * <ClientRouter /> turns navigation into client-side routing: the URL still
 * updates and the back button works, but only the named `content` group animates
 * (see AppShell) — the sidebar and topbar are replaced silently instead of
 * cross-fading, so the chrome appears not to move at all.
 */
import { ClientRouter } from "astro:transitions";
import "@badger3000/tokens/tokens.css";
import "@badger3000/tokens/base.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Badger3000 — Kyle Ross's AI. Ask about his projects, writing, and experience.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />

    <!--
      Restore the stored skin before first paint (no flash of the wrong theme),
      and carry it onto every incoming page. A swap copies the new document's
      `data-theme="light"` onto <html>, so the skin is set on that document
      before the swap, while the view transition is still capturing it. This
      script sits in <head> unchanged on every page, so the router keeps it and
      it runs once per document.
    -->
    <script is:inline>
      (() => {
        const read = () => {
          try {
            const stored = localStorage.getItem("badger-theme");
            return stored === "dark" || stored === "forest" || stored === "light" ? stored : "light";
          } catch {
            return "light"; /* private mode / storage disabled */
          }
        };
        document.documentElement.dataset.theme = read();
        document.addEventListener("astro:before-swap", (event) => {
          event.newDocument.documentElement.dataset.theme =
            document.documentElement.dataset.theme || read();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 0 0 9px 0;
    background: var(--a-accent);
    color: var(--a-on-accent);
    font-family: var(--af-ui);
    font-size: 13px;
    font-weight: 600;
  }
  .skip:focus {
    left: 0;
  }

  /*
   * View transitions. The default is a full-page cross-fade of the root group,
   * which would fade the sidebar and topbar along with the content. The chrome
   * must look untouched, so the root group does not animate and only the named
   * `content` group (AppShell's scroll area) transitions.
   */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-group(content) {
    animation-duration: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>