---
/**
 * Browse — Golf. Pen `oH8H5` (drawer open: `pe68N`; states `PVsfQ`, `INrUU`,
 * `N6YGg`, `U5zm0`; mobile `fwtQD`; dark `oAQkk`).
 *
 *   PageHead      Golf scores + "Last 20 of 47" badge + Ask Badger
 *   Summary       HandicapCard + StatTile × 3 (best, average, courses)
 *   ChartCard     last 20 rounds, accent = counts toward the handicap
 *   Courses       CourseCard scroller → CourseDrawer
 *   Rounds        All / Counted filter + table with the TEE column
 *
 * One fetch (`golfPageQuery`); the WHS maths is `lib/golf.ts`, shaped into plain
 * values by `lib/golf-view.ts`. The island is `lib/golf-page.ts`.
 */
import Browse from "../layouts/Browse.astro";
import { Button, HandicapCard, Icon, StatTile } from "@badger3000/ui";
import CourseDrawer from "../components/CourseDrawer.astro";
import CourseStrip from "../components/CourseStrip.astro";
import GolfChart from "../components/GolfChart.astro";
import RoundsTable from "../components/RoundsTable.astro";
import { getGolfPage, getCounts, getSettings } from "../lib/sanity/index.ts";
import { buildGolfView } from "../lib/golf-view.ts";

const [page, counts, settings] = await Promise.all([getGolfPage(), getCounts(), getSettings()]);
const view = buildGolfView(page);
const { handicap, summary } = view;
const empty = view.shown.length === 0;
---

<Browse
  title="Golf scores"
  description="The other obsession. Only the last 20 rounds count toward the handicap."
  active="golf"
  counts={counts}
  settings={settings}
  count={view.badge}
  countLabel="rounds logged"
  sub="The other obsession. Only the last 20 rounds count toward the handicap."
>
  <Button slot="actions" variant="soft" href="/?q=golf" label="Ask Badger" class="ask">
    <Icon slot="icon" name="sparkles" />
  </Button>

  <div data-browse>
    <section class="summary" aria-label="Handicap summary" data-item data-search="handicap index whs best round average courses played">
      <HandicapCard
        index={handicap.index}
        trend={handicap.trend}
        since={handicap.since}
        note={handicap.note}
        source={handicap.source}
        needs={handicap.needs}
      />
      <dl class="stats">
        <div>
          <dt class="sr">Best round · last 20</dt>
          <dd><StatTile icon="trophy" value={empty ? "—" : summary.best} label="Best round · last 20" /></dd>
        </div>
        <div>
          <dt class="sr">Average · last 20</dt>
          <dd><StatTile icon="activity" value={empty ? "—" : summary.avg} label="Average · last 20" /></dd>
        </div>
        <div>
          <dt class="sr">Courses played</dt>
          <dd><StatTile icon="map-pin" value={summary.courses || "—"} label="Courses played" /></dd>
        </div>
      </dl>
    </section>

    {
      empty ? (
        <p class="empty" data-item data-search="no rounds yet">
          No rounds logged yet. Add one in Studio and it shows up here, with the handicap once there are three.
        </p>
      ) : (
        <>
          <GolfChart cols={view.chart.cols} used={view.used} first={view.chart.first} last={view.chart.last} />
          <CourseStrip courses={view.courses} />
          <RoundsTable rounds={view.shown} countedCount={view.countedCount} range={view.range} />
        </>
      )
    }
  </div>

  <CourseDrawer courses={view.courses} windowSize={20} />
</Browse>

<style>
  .summary {
    display: grid;
    grid-template-columns: minmax(300px, 360px) 1fr;
    gap: 14px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 0;
  }
  .stats > div {
    display: contents;
  }
  .stats dd {
    margin: 0;
    display: flex;
  }
  .stats dd > :global(.tile) {
    flex: 1;
  }
  .empty {
    margin: 0;
    padding: 28px;
    border: 1px dashed var(--a-line-2);
    border-radius: 14px;
    color: var(--a-muted);
    font-size: 14px;
    text-align: center;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 900px) {
    .summary {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .stats {
      gap: 8px;
    }
  }
</style>

<script>
  import "../lib/browse.ts";
  import "../lib/golf-page.ts";
</script>
