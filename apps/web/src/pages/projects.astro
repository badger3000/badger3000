---
/**
 * Browse — Projects. Pen screen `uXl4B`.
 * context: section · page / app shell → main · archive → div.container
 *
 *   header · page header   PageHeader (title + count + Ask Badger + search)
 *   nav · topic filters    FilterBar + view toggle
 *   ul · card grid         FeatureCard × projects (`f3kriq`)
 *
 * The pen's filter labels ("All / Web App / Open Source / Client Work /
 * Experiment") are placeholders — the dataset has four topics and every project
 * shares one, so the chips are built from the topics that actually have
 * projects. The sort control is omitted: there is no date field to sort by.
 */
import Base from "../layouts/Base.astro";
import AppShell from "../layouts/AppShell.astro";
import { Button, Card, FeatureCard, FilterBar, Icon, Input, PageHeader } from "@badger3000/ui";
import { getProjects, getTopics, getCounts, getSettings } from "../lib/sanity/index.ts";

const [projects, topics, counts, settings] = await Promise.all([
  getProjects(),
  getTopics(),
  getCounts(),
  getSettings(),
]);

// Only chips that would actually show something.
const used = new Set(projects.map((p) => p.topicSlug));
const chips = topics
  .flatMap((topic) =>
    topic.title && topic.slug && used.has(topic.slug) ? [{ label: topic.title, value: topic.slug }] : [],
  );

/** Tech slugs as people write them: "node-js" → "Node.js", "css3" → "CSS3". */
const LABELS: Record<string, string> = {
  js: "JS",
  ts: "TypeScript",
  javascript: "JavaScript",
  html5: "HTML5",
  css3: "CSS3",
  "node-js": "Node.js",
  nodejs: "Node.js",
  sass: "Sass",
  aws: "AWS",
  hubspot: "HubSpot",
  webflow: "Webflow",
  java: "Java",
  php: "PHP",
};
const techLabel = (tech: string) => LABELS[tech] ?? tech.replace(/-/g, " ");

// The year stamp has no field of its own: `_createdAt` is when the *document*
// was created, not when the work shipped — swap in a real year if one appears.
const yearOf = (iso: string | null) => (iso ? new Date(iso).getFullYear() : undefined);

const searchIndex = projects.map((p) =>
  [p.title ?? "", p.topic ?? "", (p.tech ?? []).join(" ")].join(" ").toLowerCase(),
);
---

<Base
  title="Projects — Badger3000"
  description="Things Kyle has designed, built, and shipped."
>
  <AppShell
    active="projects"
    counts={counts}
    settings={settings}
    mobileBar="page"
    mobileTitle="Projects"
    mobileCount={projects.length}
    mobileTab="explore"
    mobileBottom="tabs"
  >
    <main class="archive" id="main">
      <div class="inner" data-browse>
        <PageHeader title="Projects" count={projects.length} countLabel="projects" sub="Things Kyle has designed, built, and shipped.">
          <Fragment slot="actions">
            <Button variant="soft" href="/" label="Ask Badger" class="ask">
              <Icon slot="icon" name="sparkles" />
            </Button>
            <Input
              name="q"
              label="Search projects"
              placeholder="Search projects…"
              width={220}
              class="search"
            />
            <div class="viewtoggle" role="group" aria-label="Card layout">
              <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid view">
                <Icon name="layout-grid" size={15} />
              </button>
              <button type="button" data-view="list" aria-pressed="false" aria-label="List view">
                <Icon name="list" size={15} />
              </button>
            </div>
          </Fragment>
        </PageHeader>

        <FilterBar chips={chips} />

        {
          projects.length === 0 ? (
            <Card class="empty">
              <p>No projects in this dataset yet.</p>
            </Card>
          ) : (
            <ul class="grid" data-grid>
              {projects.map((project, i) => (
                <li data-item data-topic={project.topicSlug ?? ""} data-search={searchIndex[i]}>
                  <FeatureCard
                    level={2}
                    title={project.title ?? "Untitled"}
                    seed={project.id}
                    href={project.webUrl ?? undefined}
                    topic={project.topic ?? undefined}
                    excerpt={project.excerpt ?? undefined}
                    tech={(project.tech ?? []).map(techLabel)}
                    year={yearOf(project.createdAt)}
                  />
                </li>
              ))}
            </ul>
          )
        }

        <p class="empty-note" data-empty hidden>Nothing matches that search.</p>
      </div>
    </main>
  </AppShell>
</Base>

<style>
  .archive {
    background: var(--a-bg);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px 40px;
  }

  .viewtoggle {
    display: flex;
    overflow: hidden;
    border: 1px solid var(--a-line-2);
    border-radius: 10px;
    background: var(--a-surface);
  }
  .viewtoggle button {
    display: grid;
    place-items: center;
    padding: 9px;
    border: 0;
    background: transparent;
    color: var(--a-muted);
    cursor: pointer;
  }
  .viewtoggle button[aria-pressed="true"] {
    background: var(--a-ink);
    color: var(--a-surface);
  }
  /*
   * The group clips its buttons, so the shared ring moves to the group, and the
   * focused button gets an inner edge so it's clear which of the two it is.
   */
  .viewtoggle:has(button:focus-visible) {
    outline: 2px solid var(--a-accent-text);
    outline-offset: 2px;
  }
  .viewtoggle button:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 2px var(--a-accent-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* List view: one column, cards stretch. Pen's toggle is grid | list. */
  .grid[data-view="list"] {
    grid-template-columns: minmax(0, 1fr);
  }
  .grid[data-view="list"] :global(.card) {
    flex-direction: row;
  }

  .empty :global(p) {
    margin: 0;
    color: var(--a-muted);
    font-size: 13px;
  }
  .empty-note {
    margin: 0;
    font-size: 13px;
    color: var(--a-subtle);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .inner {
      padding: 20px 16px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import "../lib/browse.ts";
</script>
