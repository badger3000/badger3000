---
/**
 * Agent home — pen `l7yp4` (Agent UI — Home) and `p9dFND` (Mobile — Home).
 * context: section · page / app shell
 *   aside · site navigation | main | header | section · hero | footer
 *
 * One `<Composer>` serves both layouts. It is the fourth child of the hero
 * column; `order` places it between the greeting and the chips on desktop (pen
 * `bHb5v` Prompt) and last, pushed to the bottom with `margin-top: auto`, on
 * mobile (pen `as8tT` Composer Wrap). No duplicate markup, no second form.
 *
 * The composer posts to `/api/chat`, and the island in `lib/chat.ts` intercepts
 * the submit so the thread updates without a page load (`AppShell` already
 * loads that module through `lib/shell.ts`; importing it here says so). The greeting and chips
 * give way to the thread once there is one (`data-has-thread`).
 */
import Base from "../layouts/Base.astro";
import AppShell from "../layouts/AppShell.astro";
import Composer from "../components/Composer.astro";
import { Avatar, SuggestionChip } from "@badger3000/ui";
import MessageBubble from "../components/MessageBubble.astro";
import AgentMessage from "../components/AgentMessage.astro";
import ChatCard from "../components/ChatCard.astro";
import { getCounts, getSettings } from "../lib/sanity/index.ts";

const [counts, settings] = await Promise.all([getCounts(), getSettings()]);

const chips = [
  { label: "Show recent projects", prompt: "Show me your recent projects" },
  { label: "Read latest articles", prompt: "What are your latest articles about?" },
  { label: "Walk me through his experience", prompt: "Walk me through Kyle's experience" },
  { label: "Show golf scores", prompt: "Show me Kyle's golf scores" },
];
---

<Base title="Badger3000 — Kyle Ross's AI">
  <AppShell counts={counts} settings={settings} mobileBar="menu" mobileTab="chat" mobileBottom="footer">
    <main class="hero" id="main" data-chat-root>
      <section class="thread" aria-label="Conversation" data-chat-log></section>
      {/*
        The live region. The thread repaints as a whole, so it can't be live
        itself; the island writes only the newest agent turn here.
      */}
      <p class="sr" role="status" data-chat-status></p>

      <Avatar size={76} mobileSize={66} class="hero-avatar" />

      <div class="greet">
        <h1>Hey — I'm Badger3000.</h1>
        <p class="sub desktop-sub">
          Kyle Ross's AI. Ask about his projects, writing, and experience — or just say hi.
        </p>
        <p class="sub mobile-sub">Kyle's AI. Ask about his work, writing, or anything else.</p>
      </div>

      <div class="dock">
        <Composer chat />
      </div>

      <div class="chips">
        {chips.map((chip) => <SuggestionChip label={chip.label} prompt={chip.prompt} />)}
      </div>
    </main>

    {/* The chat island clones these, so each turn is defined once by a component. */}
    <template data-chat-bubble><MessageBubble /></template>
    <template data-chat-message><AgentMessage /></template>
    <template data-chat-card><ChatCard /></template>
    <template data-chat-suggestion><SuggestionChip label="" prompt="" /></template>
  </AppShell>
</Base>

<style>
  /* The thread sits above the greeting and takes the page once there is one. */
  .thread {
    display: none;
    order: 0;
    flex-direction: column;
    gap: 24px;
    width: 720px;
    max-width: 100%;
    margin: 0 auto;
    text-align: left;
  }
  :global([data-has-thread="true"]) .thread {
    display: flex;
    flex: 1;
  }
  :global([data-has-thread="true"]) .greet,
  :global([data-has-thread="true"]) .chips,
  .hero[data-has-thread="true"] :global(.hero-avatar) {
    display: none;
  }
  :global(.chat-tag) {
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--a-accent-soft);
    color: var(--a-accent-text);
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 10.5px;
    white-space: nowrap;
  }

  /* Desktop: a centred column, composer between greeting and chips. */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex: 1;
    padding: 20px 40px;
    text-align: center;
  }
  .hero :global(.hero-avatar) {
    order: 1;
  }
  .greet {
    order: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .greet h1 {
    margin: 0;
    font-family: var(--af-display);
    font-size: 44px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--a-ink);
  }
  .sub {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.45;
    color: var(--a-muted);
  }
  .dock {
    order: 3;
    width: 600px;
    max-width: 100%;
  }
  .chips {
    order: 4;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .mobile-sub {
    display: none;
  }

  /* Mobile (pen p9dFND): avatar 66, greeting 30/14.5, chips under it, and the
     composer docked above the footer. */
  @media (max-width: 720px) {
    .hero {
      justify-content: flex-start;
      gap: 18px;
      min-height: 100%;
      padding: 16px 22px 0;
      text-align: center;
    }
    .thread {
      gap: 18px;
    }
    .greet h1 {
      font-size: 30px;
    }
    .desktop-sub {
      display: none;
    }
    .mobile-sub {
      display: block;
      font-size: 14.5px;
    }
    .chips {
      order: 3;
      gap: 9px;
      padding-top: 8px;
      /* Split the free space above and below the greeting group so it sits
         centred in the hero, with the composer docked under it (pen hQ1Ih is
         justifyContent center inside the space left by as8tT). */
      margin-bottom: auto;
    }
    .hero :global(.hero-avatar) {
      margin-top: auto;
    }
    .dock {
      order: 4;
      width: 100%;
      padding: 4px 14px 8px;
    }
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
<script>
  import "../lib/chat.ts";
</script>
