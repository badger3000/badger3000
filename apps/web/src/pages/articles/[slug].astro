---
/**
 * Article — Detail. Pen `I4mvDB`, spec in docs/review/2026-10-22/design.md §D.
 * context: article · articleBySlugQuery ← articles
 *
 *   Content 856, padding [48, 80, 80], gap 40:
 *   Back         "Back to Articles" 13 `$a-muted`
 *   Header 800   centred · gap 20 · Tag ← topic · h1 display 56 · lede 18
 *   Byline       centred · AvatarUser 24 · name · date · read time
 *   Hero         800×380 r12 ← main_image + caption overlay, else gradientFor(_id)
 *   Column 720   gap 22: Portable Text · citation (republished only) · tags
 *                (the topic; the schema has no tags array) · divider ·
 *                "More from the journal" + 3 × ProjectCard, same topic first
 *
 * Prerendered: one page per slug. With `SANITY_ALLOW_EMPTY=1` and no
 * credentials there are no slugs, so the route builds nothing.
 */
import type { GetStaticPaths } from "astro";
import { SANITY_ALLOW_EMPTY } from "astro:env/server";
import Base from "../../layouts/Base.astro";
import AppShell from "../../layouts/AppShell.astro";
import PortableBody from "../../components/portable/PortableBody.astro";
import { sources } from "../../components/portable/media.ts";
import { AvatarUser, Icon, ProjectCard, Tag } from "@badger3000/ui";
import { gradientFor } from "@badger3000/tokens/covers";
import { articleBySlugQuery, articleSlugsQuery } from "@badger3000/sanity/queries";
import { getCounts, getSettings, imageUrl, isConfigured, sanity } from "../../lib/sanity/index.ts";
import type { SeoProps } from "../../lib/seo.ts";

export const getStaticPaths = (async () => {
  if (!isConfigured && SANITY_ALLOW_EMPTY === "1") return [];
  const slugs = await sanity().fetch(articleSlugsQuery);
  return slugs.flatMap((slug) => (slug ? [{ params: { slug } }] : []));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const [article, counts, settings] = await Promise.all([
  sanity().fetch(articleBySlugQuery, { slug }),
  getCounts(),
  getSettings(),
]);
if (!article) throw new Error(`articleBySlugQuery returned nothing for "${slug}"`);

const title = article.title ?? "Untitled";
const date = new Date(article.publishedAt).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const byline = article.byline?.trim();
const hero = article.mainImage?.asset?.url ? sources(article.mainImage.asset, 800) : undefined;
const citation = article.citation;
const author = citation?.authorName?.trim();
const seo: SeoProps = {
  title,
  description: article.excerpt ?? undefined,
  type: "article",
  publishedTime: article.publishedAt,
  // Share cards want a plain JPEG: crawlers don't negotiate formats.
  image: imageUrl(article.mainImage?.asset?.url, { width: 1200, format: "jpg" }),
};
---

<Base seo={seo}>
  <AppShell
    active="articles"
    counts={counts}
    settings={settings}
    mobileBar="page"
    mobileTitle="Articles"
    mobileBottom="tabs"
  >
    <main class="detail" id="main">
      <article class="wrap">
        <a class="back" href="/articles">
          <Icon name="arrow-left" size={14} />
          Back to Articles
        </a>

        <header class="head">
          {article.topic && <Tag label={article.topic} />}
          <h1 class="title">{title}</h1>
          {article.excerpt && <p class="lede">{article.excerpt}</p>}
        </header>

        <p class="byline">
          {byline && <AvatarUser name={byline} size={24} />}
          {byline && <span>{byline}</span>}
          {byline && <span class="dot" aria-hidden="true">·</span>}
          <time datetime={article.publishedAt}>{date}</time>
          <span class="dot" aria-hidden="true">·</span>
          <span>{article.readTime} min read</span>
        </p>

        {
          hero ? (
            <figure class="hero">
              <img
                src={hero.src}
                srcset={hero.srcset}
                sizes="(max-width: 720px) calc(100vw - 32px), 800px"
                width={hero.width}
                height={hero.height}
                alt={article.mainImage?.alt ?? ""}
                fetchpriority="high"
              />
              {article.mainImage?.caption && <figcaption>{article.mainImage.caption}</figcaption>}
            </figure>
          ) : (
            <div class="hero" style={`background:${gradientFor(article.id)}`} aria-hidden="true" />
          )
        }

        <div class="column">
          <PortableBody value={article.content ?? []} gap={22} />

          {
            citation && (
              <aside class="citation" aria-label="Original source">
                <p class="cite-head">Originally published elsewhere</p>
                <p class="cite-text">
                  {citation.disclaimer ??
                    `This article was written by ${author ?? "another author"} and is shared here with credit.`}
                </p>
                <p class="cite-links">
                  {author &&
                    (citation.authorProfileUrl ? (
                      <a href={citation.authorProfileUrl} target="_blank" rel="noopener noreferrer">
                        {author}
                        <span class="sr">(opens in a new tab)</span>
                      </a>
                    ) : (
                      <span>{author}</span>
                    ))}
                  {citation.originalArticleUrl && (
                    <a href={citation.originalArticleUrl} target="_blank" rel="noopener noreferrer">
                      Read the original
                      <Icon name="arrow-up-right" size={13} />
                      <span class="sr">(opens in a new tab)</span>
                    </a>
                  )}
                </p>
              </aside>
            )
          }

          {
            article.topic && (
              <ul class="tags" aria-label="Topic">
                <li>
                  <Tag label={article.topic} />
                </li>
              </ul>
            )
          }

          {
            article.related.length > 0 && (
              <section class="more" aria-labelledby="more-head">
                <div class="more-head">
                  <h2 id="more-head">More from the journal</h2>
                  <a href="/articles">View all →</a>
                </div>
                <ul class="related">
                  {article.related.map((item) => (
                    <li>
                      <ProjectCard
                        title={item.title ?? "Untitled"}
                        href={`/articles/${item.slug}`}
                        seed={item.id}
                        topic={item.topic ?? undefined}
                        excerpt={item.excerpt ?? undefined}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
      </article>
    </main>
  </AppShell>
</Base>

<style>
  .detail {
    display: flex;
    justify-content: center;
    padding: 48px 80px 80px;
    background: var(--a-bg);
  }
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    width: 100%;
    max-width: 856px;
    min-width: 0;
  }

  .back {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    letter-spacing: 0.2px;
    color: var(--a-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--a-ink);
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 800px;
    text-align: center;
  }
  .head > :global(.tag) {
    align-self: center;
  }
  .title {
    margin: 0;
    font-family: var(--af-display);
    font-size: clamp(36px, 7vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--a-ink);
    overflow-wrap: break-word;
  }
  .lede {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--a-muted);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    margin: 0;
    padding: 8px;
    font-size: 13px;
    color: var(--a-muted);
  }
  .dot {
    color: var(--a-faint);
  }

  .hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 800px;
    aspect-ratio: 800 / 380;
    margin: 16px 0;
    border: 1px solid var(--a-line);
    border-radius: 12px;
  }
  .hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero figcaption {
    position: absolute;
    right: 24px;
    bottom: 24px;
    left: 24px;
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.4;
    color: var(--a-on-cover-faint);
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
    max-width: 720px;
    min-width: 0;
  }

  .citation {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 24px;
    border: 1px solid var(--a-line-2);
    border-radius: 8px;
    background: var(--a-accent-soft);
  }
  .cite-head {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--a-accent-text);
  }
  .cite-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--a-ink);
  }
  .cite-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 13.5px;
  }
  .cite-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--a-accent-text);
    font-weight: 600;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }

  /* Divider, then the head: padding [24, 0, 8] under a 1px rule. */
  .more {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--a-line);
  }
  .more-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 24px 0 8px;
  }
  .more-head h2 {
    margin: 0;
    font-family: var(--af-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--a-ink);
  }
  .more-head a {
    font-size: 13px;
    color: var(--a-accent-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .more-head a:hover {
    text-decoration: underline;
  }
  .related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1080px) {
    .detail {
      padding: 40px 40px 64px;
    }
  }
  @media (max-width: 720px) {
    .detail {
      padding: 16px 16px 40px;
    }
    .wrap {
      gap: 28px;
    }
    .lede {
      font-size: 16.5px;
    }
    .hero {
      aspect-ratio: 16 / 10;
      margin: 0;
    }
    .more-head {
      padding: 0;
    }
    .related {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
