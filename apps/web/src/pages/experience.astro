---
/**
 * Browse — Experience. Pen `QTqA7` (container gap 20, not 22).
 *
 *   PageHead (Experience + sub + Ask Badger + a Résumé download)
 *   WORK label (mono 11 `$a-faint`) · tl: one surface row per role
 *   EDUCATION label · tl: one row per qualification
 *
 * The Résumé button points at the printable experience page until a PDF is added.
 */
import Browse from "../layouts/Browse.astro";
import { Button, FilterBar, Icon } from "@badger3000/ui";
import TimelineEntry from "../components/TimelineEntry.astro";
import { getExperience, getEducation, getCounts, getSettings } from "../lib/sanity/index.ts";

const [experience, education, counts, settings] = await Promise.all([
  getExperience(),
  getEducation(),
  getCounts(),
  getSettings(),
]);
---

<Browse
  title="Experience"
  description="Twelve years building for the web."
  active="experience"
  counts={counts}
  settings={settings}
  sub="Twelve years building for the web. Here's the short version."
  gap={20}
>
  <Fragment slot="actions">
    <Button variant="soft" href="/" label="Ask Badger" class="ask">
      <Icon slot="icon" name="sparkles" />
    </Button>
    <a class="download" href="/experience">
      <Icon name="download" size={14} />
      <span>Résumé</span>
    </a>
  </Fragment>

  <div data-browse>
    <FilterBar searchPlaceholder="Search roles…" searchLabel="Search experience" />

    <h2 class="section">Work</h2>
    <ul class="timeline">
      {
        experience.map((entry) => (
          <li data-item data-search={`${entry.title} ${entry.company ?? ""} ${entry.location ?? ""}`}>
            <TimelineEntry entry={entry} href={entry.companyUrl} />
          </li>
        ))
      }
    </ul>

    {
      education.length > 0 && (
        <>
          <h2 class="section" id="education">Education</h2>
          <ul class="timeline">
            {education.map((entry) => (
              <li data-item data-search={`${entry.degree} ${entry.institution ?? ""}`}>
                <TimelineEntry entry={entry} href={entry.institutionUrl} />
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="empty" data-empty hidden>Nothing matches that search.</p>
  </div>
</Browse>

<style>
  .download {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    border-radius: 10px;
    background: var(--a-ink);
    color: var(--a-surface);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    filter: brightness(1.15);
  }

  .section {
    margin: 0;
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--a-faint);
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  import "../lib/browse.ts";
</script>