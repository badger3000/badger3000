---
/**
 * ShieldsBadge — pen master `NjGub`.
 * context: span · ShieldsBadge — props: label,value,color ← skill
 *
 *   Key   `#2B2F36` radius 5 padding [4, 8] 10.5 white   ← skill.name
 *   Value fill ← skill.badgeColor, radius 5, padding [4, 8] ← skill.badgeLabel
 *
 * `badgeLabel` is optional — plenty of skills have only a colour. The projection
 * has already normalised `badgeColor` to `#rrggbb`.
 */
interface Props {
  name: string;
  color?: string | null;
  value?: string | null;
  class?: string;
}

const { name, color, value, class: className } = Astro.props;
---

<span class:list={["badge", className]}>
  <span class="key">{name}</span>
  {value && <span class="value" style={color ? `background:${color}` : undefined}>{value}</span>}
</span>

<style>
  .badge {
    display: inline-flex;
    overflow: hidden;
    border-radius: 5px;
    font-family: var(--af-ui), ui-sans-serif, system-ui, sans-serif;
    font-size: 10.5px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .key,
  .value {
    padding: 4px 8px;
    color: #fff;
  }
  .key {
    background: #2b2f36;
  }
  .value {
    background: var(--a-line-2);
  }
</style>