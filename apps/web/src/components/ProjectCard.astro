---
/**
 * ProjectCard — pen master `FE7oC`, built from the richer screen card
 * (`uXl4B` → Hkm7Q "Trailhead"), which is the version that actually renders the
 * tech chips the master's own context promises (`project{…,tech[],…}`).
 *
 * context: article · ProjectCard ← project{title,topic,tech[],webUrl,order}
 *
 * Slots, in pen order:
 *   pv     96px cover, gradient, monogram `title[0]`, year badge
 *   tg     Tag ← project.topic
 *   ti     ← project.title
 *   d      ← project.excerpt            (see note below)
 *   tc     tech chips + external link
 *
 * Two bindings do not exist as written in the pen:
 *   • `project.excerpt` — the schema has no such field; the content lives in
 *     `project_description` (portable text), which the projection flattens to
 *     the first block's text as `excerpt`. 3 of 9 projects have none, and the
 *     line is then skipped rather than padded with invented copy.
 *   • the year badge has no binding at all, so it comes from `_createdAt`.
 *     That is when the *document* was created, not when the work shipped —
 *     swap in a real year field if one appears.
 *
 * The cover is the pen's gradient. Every project has a `project_image`, so
 * swapping `Preview` for an `<Image>` is a one-line change whenever the pen is
 * updated to allow it.
 */
import Icon from "./Icon.astro";
import Tag from "./Tag.astro";
import { gradientFor } from "@badger3000/tokens/covers";
import type { Project } from "../lib/sanity/types.ts";

interface Props {
  project: Project;
  year?: number;
}

const { project, year } = Astro.props;

/** "node-js" → "Node.js", "css3" → "CSS3", "js" → "JS". */
const LABELS: Record<string, string> = {
  js: "JS",
  ts: "TypeScript",
  javascript: "JavaScript",
  html5: "HTML5",
  css3: "CSS3",
  "node-js": "Node.js",
  nodejs: "Node.js",
  sass: "Sass",
  aws: "AWS",
  hubspot: "HubSpot",
  webflow: "Webflow",
  java: "Java",
  php: "PHP",
};

const label = (tech: string) => LABELS[tech] ?? tech.replace(/-/g, " ");

const monogram = project.title.trim().charAt(0);
const tech = project.tech.map(label);
const cardYear = year ?? (project.createdAt ? new Date(project.createdAt).getFullYear() : undefined);
---

<article class="card">
  <div class="pv" style={`background:${gradientFor(project.id)}`}>
    <span class="mono" aria-hidden="true">{monogram}</span>
    {cardYear && <span class="yb">{cardYear}</span>}
  </div>

  <div class="bd">
    {project.topic && <Tag label={project.topic} />}

    {
      project.webUrl ? (
        <a class="ti" href={project.webUrl} target="_blank" rel="noopener">
          {project.title}
        </a>
      ) : (
        <span class="ti">{project.title}</span>
      )
    }

    {project.excerpt && <p class="desc">{project.excerpt}</p>}

    {
      tech.length > 0 && (
        <div class="tc">
          <span class="chips">
            {tech.map((t) => (
              <span class="chip">{t}</span>
            ))}
          </span>
          {project.webUrl && (
            <a
              class="out"
              href={project.webUrl}
              target="_blank"
              rel="noopener"
              aria-label={`${project.title} — opens ${new URL(project.webUrl).hostname}`}
            >
              <Icon name="arrow-up-right" size={15} />
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }

  /* pv — pen cover gradient, 220deg, one pair per project (`gradientFor`) */
  .pv {
    position: relative;
    height: 96px;
  }
  .mono {
    position: absolute;
    top: 12px;
    left: 14px;
    font-family: var(--af-display);
    font-size: 44px;
    line-height: 1;
    color: var(--a-on-cover);
    opacity: 0.9;
  }
  .yb {
    position: absolute;
    bottom: 12px;
    left: 14px;
    padding: 4px 9px;
    border-radius: 8px;
    background: var(--a-cover-overlay);
    color: var(--a-on-cover-soft);
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 10.5px;
    line-height: 1.2;
    backdrop-filter: blur(2px);
  }

  .bd {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 14px;
  }
  .ti {
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--a-ink);
    text-decoration: none;
  }
  a.ti:hover {
    color: var(--a-accent);
  }
  .desc {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--a-muted);
  }

  .tc {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 4px;
  }
  .chips {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 2px 7px;
    border: 1px solid var(--a-line);
    border-radius: 5px;
    background: var(--a-bg);
    color: var(--a-muted);
    font-size: 10.5px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .out {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--a-faint);
  }
  .out:hover {
    color: var(--a-accent);
  }
  .out:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>