---
/**
 * AgentMessage — pen master `CVVRV`.
 * context: div · AgentMessage — props: line, children(cards)
 *
 *   avatar 26/9 · Body gap 12 · Line 15 `$a-ink` · the card slot
 *
 * Doubles as the `<template>` the chat island clones, so this file is the single
 * definition of an agent turn.
 */
import { Avatar, Button } from "@badger3000/ui";

interface Props {
  line?: string;
}

const { line = "" } = Astro.props;
---

<div class="turn" data-chat-turn>
  <Avatar size={26} />
  <div class="body">
    <p class="line" data-slot="line">{line}</p>
    {/*
      pen `A Pending` — the loading state while /api/chat is in flight. The
      dots are visual only; the page's status region says "thinking".
    */}
    <span class="typing" data-typing aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <div class="cards" data-chat-cards></div>
    {/* SuggestionChips the answer offers next (`suggestions`), cloned in. */}
    <div class="suggestions" data-chat-suggestions></div>
    {/* Shown only when the answer failed in a way worth re-asking. */}
    <div class="retry" data-chat-retry hidden><Button variant="secondary" label="Try again" /></div>
  </div>
</div>

<style>
  .turn {
    display: flex;
    gap: 12px;
    width: 100%;
    max-width: 620px;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .line {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--a-ink);
  }

  /* The pending indicator replaces the line; both live in the same 20px band so
     nothing shifts when the answer lands. */
  .typing {
    display: none;
    align-items: center;
    gap: 5px;
    height: 20px;
  }
  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--a-faint);
    animation: dot-pulse 1.2s var(--ease-linear) infinite;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .turn[data-pending] .line {
    display: none;
  }
  .turn[data-pending] .typing {
    display: flex;
  }

  .turn[data-enter] {
    animation: turn-in var(--duration-fast) var(--ease-smooth-out) both;
  }
  .turn[data-enter] .cards :global([data-chat-card]) {
    animation: turn-in var(--duration-fast) var(--ease-smooth-out) both;
    animation-delay: calc(var(--i, 0) * var(--duration-stagger));
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .retry {
    align-self: flex-start;
  }
  .retry[hidden] {
    display: none;
  }
</style>