---
/**
 * AskBadger — the accent pill that opens the agent, repeated on every browse
 * screen (`ask` in the pen's PageHead, e.g. `EChxr` on Browse — Articles).
 *
 * surface: `$a-accent-soft` · radius 10 · gap 7 · padding [9, 13]
 * sparkles 15 `$a-accent` · label 13/600 `$a-accent`
 */
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href = "/", label = "Ask Badger", class: className } = Astro.props;
---

<a class:list={["ask", className]} href={href}>
  <Icon name="sparkles" size={15} />
  <span>{label}</span>
</a>

<style>
  .ask {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-radius: 10px;
    background: var(--a-accent-soft);
    color: var(--a-accent);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .ask:hover {
    filter: brightness(0.97);
  }
  .ask:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 2px;
  }
</style>