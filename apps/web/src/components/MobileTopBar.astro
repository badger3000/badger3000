---
/**
 * MobileTopBar — pen `QIR7a` (Mobile — Home) and `yM5Vm` (Mobile — Browse).
 *
 *   home    padding [16, 18] · menu button 34/10 · title 24/8 + "Badger3000" 15/600
 *   browse  padding [14, 16] · back button 34/10 · title 16/600 + count chip
 *                                      · search button 34/10
 *
 *   titled  Mobile — Contact (`CzR37`): menu button · page title 16/600 · user chip
 *
 * Desktop keeps Sidebar + TopBar; this only exists below 720px, which is the
 * only way to reach the nav there. The menu, back and search buttons are
 * IconButton's `ghost` variant, delegated from `lib/shell.ts`.
 */
import { Avatar, IconButton } from "@badger3000/ui";

interface Props {
  variant?: "menu" | "page" | "titled";
  /** Browse variant: the page name in the bar. */
  title?: string;
  /** Browse variant: the count chip beside the title. */
  count?: number;
  initials?: string;
}

const { variant = "menu", title = "Badger3000", count, initials = "KR" } = Astro.props;
---

<header class="m-topbar">
  {
    variant === "titled" ? (
      <>
        <IconButton icon="menu" iconSize={18} label="Open menu" variant="ghost" data-drawer-open />
        <span class="title">
          <span class="page">{title}</span>
        </span>
        <a class="user" href="/bookmarks" aria-label="Your saved items">
          {initials}
        </a>
      </>
    ) : variant === "menu" ? (
      <>
        <IconButton icon="menu" iconSize={18} label="Open menu" variant="ghost" data-drawer-open />
        <span class="title">
          <Avatar size={24} />
          <span class="name">{title}</span>
        </span>
        <a class="user" href="/bookmarks" aria-label="Your saved items">
          {initials}
        </a>
      </>
    ) : (
      <>
        <IconButton icon="chevron-left" iconSize={18} label="Go back" variant="ghost" data-drawer-back />
        <span class="title">
          <span class="page">{title}</span>
          {count !== undefined && <span class="chip">{count}</span>}
        </span>
        <IconButton icon="search" label="Search" variant="ghost" data-search-focus />
      </>
    )
  }
</header>

<style>
  .m-topbar {
    display: none;
  }

  @media (max-width: 720px) {
    .m-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex: none;
      padding: 14px 16px;
      background: var(--a-surface);
      border-bottom: 1px solid var(--a-line);
    }
  }

  .title {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }
  .name,
  .page {
    overflow: hidden;
    font-size: 15px;
    font-weight: 600;
    color: var(--a-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .page {
    font-size: 16px;
  }
  .chip {
    flex: none;
    padding: 2px 7px;
    border-radius: 10px;
    background: var(--a-accent-soft);
    color: var(--a-accent-text);
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 10.5px;
    line-height: 1.4;
  }

  .user {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: var(--a-accent-soft);
    color: var(--a-accent-text);
    font-size: 10.5px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
