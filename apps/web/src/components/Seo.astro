---
/**
 * Seo — every search and share tag in <head>, rendered by `Base`.
 *
 * Values come from `SeoProps` (src/lib/seo.ts), all optional:
 *
 *   title → "<title> — Badger3000" (unchanged when it already names the site)
 *   description, image (path or absolute URL), type ("article" adds
 *   `article:published_time`), noindex (no canonical either: the 404).
 *
 * The host is `Astro.site`, so the canonical, `og:url` and `og:image` are always
 * `https://www.badger3000.com/...` with no trailing slash. `/` also gets the
 * `Person` JSON-LD, built from the Sanity settings document.
 */
import type { SeoProps } from "../lib/seo.ts";
import {
  AUTHOR,
  DEFAULT_DESCRIPTION,
  DEFAULT_IMAGE,
  SITE_NAME,
  absoluteUrl,
  canonicalUrl,
  pageTitle,
} from "../lib/seo.ts";
import { getSettings } from "../lib/sanity/index.ts";

type Props = SeoProps;

const { title, description = DEFAULT_DESCRIPTION, image, type = "website", publishedTime, noindex = false } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const fullTitle = pageTitle(title);
const url = canonicalUrl(Astro.url.pathname, site);
const imageUrl = absoluteUrl(image ?? DEFAULT_IMAGE.path, site);
// Width and height are only known for the default image.
const imageSize = image ? undefined : DEFAULT_IMAGE;
const feed = new URL("/rss.xml", site).href;

const isHome = url === new URL("/", site).href;
const settings = isHome ? await getSettings() : null;
const person = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      name: settings?.name ?? AUTHOR,
      url,
      ...(settings?.avatarImage?.asset?.url ? { image: settings.avatarImage.asset.url } : {}),
      ...(settings?.occupation || settings?.title ? { jobTitle: settings.occupation ?? settings.title } : {}),
      ...(settings?.location ? { address: { "@type": "PostalAddress", addressLocality: settings.location } } : {}),
      sameAs: (settings?.links ?? []).map((link) => link.webUrl).filter((href): href is string => !!href),
    }
  : null;
// `<` escaped so no Sanity string can close the script element.
const jsonLd = person && JSON.stringify(person).replace(/</g, "\\u003c");
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={url} />}
<meta property="og:image" content={imageUrl} />
{
  imageSize && (
    <>
      <meta property="og:image:width" content={String(imageSize.width)} />
      <meta property="og:image:height" content={String(imageSize.height)} />
      <meta property="og:image:alt" content={imageSize.alt} />
    </>
  )
}
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && <meta property="article:author" content={AUTHOR} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="alternate" type="application/rss+xml" title={`${AUTHOR} - Articles`} href={feed} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="manifest" href="/manifest.json" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
