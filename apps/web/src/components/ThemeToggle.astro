---
/**
 * ThemeToggle — cycles the three pen skins (light → dark → forest).
 * Persists to localStorage; the `data-theme` attribute on <html> is what
 * tokens.css keys off (see src/styles/tokens.css).
 *
 * The pre-paint application of the stored theme lives in Base.astro; clicks
 * and `aria-pressed` are handled by the delegate in `lib/shell.ts`, which also
 * serves the mobile drawer's segment. Every option renders unpressed and is
 * painted on `astro:page-load`.
 */
import Icon from "./Icon.astro";

const themes = ["light", "dark", "forest"] as const;
const icons: Record<(typeof themes)[number], string> = {
  light: "sun",
  dark: "moon",
  forest: "trees",
};
const labels: Record<(typeof themes)[number], string> = {
  light: "Light theme",
  dark: "Dark theme",
  forest: "Forest theme",
};
---

<div class="toggle" data-theme-toggle>
  {
    themes.map((theme) => (
      <button
        type="button"
        class="opt"
        data-theme-option={theme}
        aria-pressed="false"
        aria-label={labels[theme]}
        title={labels[theme]}
      >
        <Icon name={icons[theme]} size={15} />
      </button>
    ))
  }
</div>

<style>
  .toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--a-line-2);
    border-radius: 9px;
    background: var(--a-surface);
  }
  .opt {
    display: grid;
    place-items: center;
    width: 28px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--a-faint);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .opt:hover {
    color: var(--a-ink);
  }
  .opt[aria-pressed="true"] {
    background: var(--a-accent-soft);
    color: var(--a-accent);
  }
  .opt:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 1px;
  }
</style>
