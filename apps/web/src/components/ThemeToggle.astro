---
/**
 * ThemeToggle — cycles the three pen skins (light → dark → forest).
 * Persists to localStorage; the `data-theme` attribute on <html> is what
 * tokens.css keys off (see src/styles/tokens.css).
 *
 * The pre-paint application of the stored theme lives in Base.astro; this
 * component only handles clicks, so there is no flash of the wrong skin.
 */
import Icon from "./Icon.astro";

const themes = ["light", "dark", "forest"] as const;
const icons: Record<(typeof themes)[number], string> = {
  light: "sun",
  dark: "moon",
  forest: "trees",
};
const labels: Record<(typeof themes)[number], string> = {
  light: "Light theme",
  dark: "Dark theme",
  forest: "Forest theme",
};
---

<div class="toggle" data-theme-toggle>
  {
    themes.map((theme) => (
      <button
        type="button"
        class="opt"
        data-theme-option={theme}
        aria-label={labels[theme]}
        title={labels[theme]}
      >
        <Icon name={icons[theme]} size={15} />
      </button>
    ))
  }
</div>

<style>
  .toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--a-line-2);
    border-radius: 9px;
    background: var(--a-surface);
  }
  .opt {
    display: grid;
    place-items: center;
    width: 28px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--a-faint);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .opt:hover {
    color: var(--a-ink);
  }
  .opt[aria-pressed="true"] {
    background: var(--a-accent-soft);
    color: var(--a-accent);
  }
  .opt:focus-visible {
    outline: 2px solid var(--a-accent);
    outline-offset: 1px;
  }
</style>

<script>
  const THEMES = ["light", "dark", "forest"] as const;
  type Theme = (typeof THEMES)[number];
  const KEY = "badger-theme";

  const isTheme = (v: string | null | undefined): v is Theme =>
    !!v && (THEMES as readonly string[]).includes(v);
  const stored = (): Theme => {
    try {
      const value = localStorage.getItem(KEY);
      return isTheme(value) ? value : "light";
    } catch {
      return "light";
    }
  };

  /**
   * Runs on the first load and again after every client-side navigation, because
   * the chrome is re-rendered rather than persisted — and because a swap copies
   * the new document's `data-theme="light"` onto <html>, which would otherwise
   * reset a dark or forest skin on every click.
   */
  const init = () => {
    const theme = stored();
    document.documentElement.dataset.theme = theme;

    for (const root of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
      const options = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-theme-option]"));
      const paint = (value: Theme) => {
        for (const option of options) {
          option.setAttribute("aria-pressed", String(option.dataset.themeOption === value));
        }
      };
      paint(theme);

      root.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "[data-theme-option]",
        );
        const next = button?.dataset.themeOption;
        if (!isTheme(next)) return;
        document.documentElement.dataset.theme = next;
        paint(next);
        try {
          localStorage.setItem(KEY, next);
        } catch {
          // Storage blocked: the skin still applies for this page view.
        }
      });
    }
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>