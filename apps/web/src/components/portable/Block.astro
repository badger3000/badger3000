---
/**
 * Block — a text block: paragraph, heading or quote.
 *
 *   p           `--pt-size`/1.65 `$a-ink`
 *   h2          display 30 (pen `N7Lpy`); an `h1` in the content renders as h2,
 *               since the page title is the only h1
 *   h3 / h4     ui 20/600 · 17/600
 *   blockquote  3px `$a-accent` bar (pen `lbRdD` / `aoecx`), `$a-muted` text
 */
import type { BlockProps } from "astro-portabletext/types";

type Props = BlockProps;

const { node } = Astro.props;
const style = node.style ?? "normal";
const Tag = style === "h1" || style === "h2" ? "h2" : style === "h3" ? "h3" : style === "h4" ? "h4" : style === "blockquote" ? "blockquote" : "p";
// Studio leaves empty blocks behind (a blank line, a cleared heading); they
// would each take a gap in the column, so they render nothing.
// `children` is the marks tree here (`@text` leaves inside `@span` marks).
type Leaf = { text?: unknown; children?: Leaf[] };
const text = (leaf: Leaf): string => (typeof leaf.text === "string" ? leaf.text : (leaf.children ?? []).map(text).join(""));
const empty = !text(node as Leaf).trim();
---

{!empty && <Tag class={Tag}><slot /></Tag>}

<style>
  .p,
  .h2,
  .h3,
  .h4,
  .blockquote {
    margin: 0;
  }
  .h2 {
    margin-top: 0.5em;
    font-family: var(--af-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
  }
  .h3 {
    margin-top: 0.4em;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }
  .h4 {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }
  .blockquote {
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--a-accent);
    color: var(--a-muted);
    font-style: italic;
  }
</style>
