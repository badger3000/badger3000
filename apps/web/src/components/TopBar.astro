---
/**
 * TopBar — pen master `r30jlq`.
 * context: header · TopBar
 *
 * The theme toggle is not in the pen; it lives here so every route gets it
 * (design-first applies to the rest of the chrome, not to this affordance).
 */
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Where the Résumé link points until the printable résumé exists (phase 3). */
  resumeHref?: string;
}

const { resumeHref = "/experience" } = Astro.props;
---

<header class="topbar">
  <span class="left">
    <span class="dot" aria-hidden="true"></span>
    <span class="name">Badger3000</span>
    <span class="status">online</span>
  </span>
  <span class="right">
    <ThemeToggle />
    <a class="resume" href={resumeHref}>
      <Icon name="file-text" size={14} />
      <span>Résumé</span>
    </a>
  </span>
</header>

<style>
  .topbar {
    position: relative;
    z-index: 1;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 22px;
    background: var(--a-surface);
    border-bottom: 1px solid var(--a-line);
  }
  .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: #3bbe7a;
  }
  .name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--a-ink);
  }
  .status {
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 11px;
    color: var(--a-faint);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border: 1px solid var(--a-line-2);
    border-radius: 9px;
    background: var(--a-surface);
    color: var(--a-ink);
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
  }
  .resume :global(svg) {
    color: var(--a-muted);
  }
  .resume:hover {
    border-color: var(--a-accent);
    color: var(--a-accent);
  }

  @media (max-width: 720px) {
    /* The mobile bar (pen QIR7a / yM5Vm) replaces it below 720px. */
    .topbar {
      display: none;
    }
  }
</style>