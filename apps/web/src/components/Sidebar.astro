---
/**
 * Sidebar — pen master `pL9CR`.
 * context: aside · Sidebar — content-type nav
 *
 * Counts come from Sanity (`getCounts()`), not from the pen's mock numbers, so
 * a route with no content yet shows nothing rather than a stale count.
 *
 * The profile block is a **drawer**: the theme tray sits above the profile
 * row inside `.profileBlock`, but the tray is collapsed by default. The gear
 * glyph in the profile row is the cycle trigger — `lib/shell.ts` listens on
 * `[data-cycle-theme]`, opens the tray and steps the theme forward on a
 * press from `data-tray-open="false"`, and folds the tray shut again on a
 * press from `data-tray-open="true"`.
 *
 * Both halves share `--a-accent-soft` fill and `--a-accent` stroke; the panel
 * itself is the outline, and `overflow: hidden` + a single `border-radius`
 * give it the rounded shape. When the tray is sliding shut the seam between
 * the two halves closes at the same time as the tray collapses, so the
 * profile row is the only thing visible at rest.
 */
import { Avatar, AvatarUser, Button, Icon, NavItem } from "@badger3000/ui";
import ThemeToggle from "./ThemeToggle.astro";
import { nav } from "../lib/nav.ts";

interface Props {
  /** id → document count, from getCounts(). Missing entries render no count. */
  counts?: Record<string, number | undefined>;
  /** Nav id of the current page. */
  active?: string;
  profile?: { name: string; location: string };
}

const { counts = {}, active, profile } = Astro.props;
---

<aside class="sidebar">
  <div class="brand">
    <Avatar size={30} />
    <span class="brandtext">
      <strong>Badger3000</strong>
      <span>Kyle's AI</span>
    </span>
    <Icon name="square-pen" size={17} class="dim" />
  </div>

  {/* pen `P2anH`: a secondary Button, full width */}
  <Button variant="secondary" href="/" label="New conversation" class="newchat" data-new-chat>
    <Icon slot="icon" name="plus" />
  </Button>

  <span class="grp">Explore</span>
  <nav class="nav" aria-label="Explore content">
    {
      nav.map((item) => (
        <NavItem
          href={item.href}
          icon={item.icon}
          label={item.label}
          count={counts[item.id]}
          active={item.id === active}
        />
      ))
    }
  </nav>

  <div class="spacer" />

  {
    profile && (
      <div class="profileBlock" data-profile-block data-tray-open="false">
        <div class="tray">
          <ThemeToggle />
        </div>
        <div class="profile" aria-label={`Signed in as ${profile.name}`}>
          <AvatarUser name={profile.name} size={30} tone="solid" />
          <span class="ptext">
            <strong>{profile.name}</strong>
            {profile.location && <span>{profile.location}</span>}
          </span>
          <button
            type="button"
            class="gear"
            data-cycle-theme
            aria-label="Cycle to the next theme"
            title="Cycle to the next theme"
          >
            <Icon name="settings" size={14} stroke={1.75} />
          </button>
        </div>
      </div>
    )
  }
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px 14px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--a-sidebar);
    border-right: 1px solid var(--a-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 2px;
  }
  .brandtext {
    display: flex;
    flex: 1;
    flex-direction: column;
    line-height: 1.25;
  }
  .brandtext strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--a-ink);
  }
  .brandtext span {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--a-subtle);
  }
  :global(.dim) {
    color: var(--a-faint);
  }

  .sidebar :global(.newchat) {
    width: 100%;
  }

  .grp {
    font-family: var(--af-mono), ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--a-subtle);
  }
  .nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .spacer {
    flex: 1;
  }

  /*
   * The profile block is a single coral surface that owns both the theme tray
   * and the profile row inside it. The tray sits above the profile row and is
   * collapsed by default; the gear flips `data-tray-open` from "false" to
   * "true" (`lib/shell.ts`) and the row grows from 0 to its natural height
   * over the standard `--duration-slow` ease.
   *
   * Colour transitions ride the same duration — background, border, ink —
   * so the active skin's tokens swap in time with the tray opening.
   */
  .profileBlock,
  .profileBlock :global(.toggle),
  .profileBlock :global(.avatar),
  .gear,
  .ptext strong,
  .ptext span {
    transition:
      background-color var(--duration-slow, 0.4s) ease,
      border-color var(--duration-slow, 0.4s) ease,
      color var(--duration-slow, 0.4s) ease;
  }
  .profileBlock {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--a-accent);
    border-radius: 12px;
    background: var(--a-accent-soft);
    overflow: hidden;
  }

  /*
   * Drawer. Closed state: tray is `height: 0; opacity: 0; visibility: hidden`
   * so its labels are fully invisible — not just clipped to a sliver the
   * grid trick was leaving. Open state: tray grows to its natural height,
   * fades in, and `visibility: visible` flips immediately. The
   * `visibility 0s 0.4s` delay on the closing transition makes the labels
   * stay interactive for the slide-down duration, then clean up after.
   *
   * Plain `height` rather than the grid `0fr` trick because the toggle's
   * intrinsic min-content kept it peeking out of the grid row — a sliver
   * was visible at the bottom even when the row collapsed.
   */
  .tray {
    height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      height var(--duration-slow, 0.4s) cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--duration-quick, 0.25s) ease,
      visibility 0s linear var(--duration-slow, 0.4s);
  }
  .tray :global(.toggle) {
    border-color: var(--a-line);
    background: var(--a-surface);
  }
  .profileBlock[data-tray-open="true"] .tray {
    height: 60px;
    opacity: 1;
    visibility: visible;
    transition:
      height var(--duration-slow, 0.4s) cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--duration-quick, 0.25s) ease,
      visibility 0s linear 0s;
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 9px;
    background: transparent;
  }
  .ptext {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
    min-width: 0;
  }
  .ptext strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--a-ink);
    /* truncate name if it spills */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ptext span {
    font-size: 11px;
    font-weight: 500;
    color: var(--a-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /*
   * The gear is the drawer trigger: it carries the same accent fill as the
   * indicator inside the tray, so when the tray opens and the highlight
   * slides in, the gear that summoned it matches that highlight visually.
   */
  .gear {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: var(--a-accent-text);
    color: var(--a-bg);
    cursor: pointer;
  }
  .gear:focus-visible {
    outline: 2px solid var(--a-on-accent);
    outline-offset: 2px;
  }
  .gear:hover {
    filter: brightness(1.05);
  }
  /* The gear glyph spins one full turn every time the cycle runs.
     `lib/shell.ts` re-adds `.spin` after a reflow so the animation restarts on
     every click instead of caching the second time round. Reduced-motion
     users get a single beat of motion (the icon jumps to its target state)
     instead of a full rotation. */
  .gear > :global(svg) {
    transform-origin: 50% 50%;
  }
  @keyframes gear-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .gear > :global(svg.spin) {
    animation: gear-spin var(--duration-slow, 0.55s) cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* When the tray is open the gear pulses once to acknowledge the open. */
  @media (prefers-reduced-motion: reduce) {
    .gear > :global(svg.spin) {
      animation: none;
      transform: rotate(60deg);
    }
  }

  @media (max-width: 720px) {
    .sidebar {
      display: none;
    }
  }
</style>
