---
/**
 * TestimonialCard — pen `hECUj` cards on Browse — Testimonials.
 *
 *   surface · radius 14 · gap 13 · padding 18
 *   quote 18 `$a-accent` · body 14 `$a-ink`
 *   footer: avatar 32/16 + name 13/600 `$a-ink` + role 11.5 `$a-subtle`
 *
 * `photo` is usually null in the dataset, so the avatar falls back to initials on
 * a tint — the same placeholder idea as the card gradients.
 */
import { Icon } from "@badger3000/ui";
import { tintFor } from "@badger3000/tokens/covers";
import type { Testimonial } from "../lib/sanity/types.ts";

interface Props {
  testimonial: Testimonial;
  class?: string;
}

const { testimonial, class: className } = Astro.props;
const initials = testimonial.name
  .split(" ")
  .map((part) => part.charAt(0))
  .slice(0, 2)
  .join("");
const role = [testimonial.role, testimonial.company].filter(Boolean).join(" · ");
const photo = testimonial.photo?.asset?.url;
---

<figure class:list={["card", className]}>
  <Icon name="quote" size={18} class="mark" />
  <blockquote>{testimonial.content}</blockquote>
  <figcaption>
    {
      photo ? (
        <img class="avatar" src={photo} alt="" width={32} height={32} loading="lazy" />
      ) : (
        <span class="avatar mark" style={`background:${tintFor(testimonial.name)}`} aria-hidden="true">
          {initials}
        </span>
      )
    }
    <span class="who">
      {
        testimonial.profileUrl ? (
          <a class="name" href={testimonial.profileUrl} target="_blank" rel="noopener">
            {testimonial.name}
          </a>
        ) : (
          <span class="name">{testimonial.name}</span>
        )
      }
      {role && <span class="role">{role}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 18px;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    background: var(--a-surface);
  }
  :global(.mark) {
    color: var(--a-accent);
  }
  blockquote {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--a-ink);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    object-fit: cover;
  }
  .avatar.mark {
    display: grid;
    place-items: center;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--a-on-cover);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .name {
    font-size: 13px;
    font-weight: 600;
    color: var(--a-ink);
    text-decoration: none;
  }
  a.name:hover {
    color: var(--a-accent-text);
  }
  .role {
    font-size: 11.5px;
    color: var(--a-subtle);
  }
</style>