# Cloudflare Workers Static Assets — response headers.
# These apply to static assets only (every page is one). Worker responses
# (/api/chat, /api/contact) set their own through `json()` in src/lib/http.ts.
#
# Astro fingerprints everything under /_astro/, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

# The CSP allows only what the site loads:
#   script  self, plus the one inline script — Base.astro's pre-paint theme
#           restore, by hash. Edit that script and its sha256 here must change
#           with it, or the theme stops restoring (a CSP error in the console).
#   style   self + inline: Astro inlines small stylesheets, and cover
#           gradients are `style` attributes.
#   img     self, the Sanity image CDN, data: (inline SVG icons).
#   font    self (@fontsource, bundled into /_astro/).
#   frame   CodePen embeds and the YouTube/Vimeo players in articles.
#   connect self (/api/chat). Workers AI runs on the Worker, not in the browser.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-xNn/k3HQ3KDh0F62KumhvC6bOhaQuWcOqs5BheIS23k='; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.sanity.io data:; font-src 'self'; connect-src 'self'; frame-src https://codepen.io https://www.youtube-nocookie.com https://player.vimeo.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# /contact loads reCAPTCHA v3 (api.js from google.com, its worker/iframe from
# gstatic and google.com), so it gets the site policy plus those hosts. A rule's
# `!` detaches the site-wide header first; otherwise the two would intersect.
# The inline-script hash is Base.astro's theme restore, same as above.
/contact
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-xNn/k3HQ3KDh0F62KumhvC6bOhaQuWcOqs5BheIS23k=' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.sanity.io data:; font-src 'self'; connect-src 'self' https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Prerendered to an extensionless file, which would otherwise be served as
# application/octet-stream.
/api/articles-feed
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# The legacy deck pulls reveal.js, Tailwind and Google Fonts from CDNs; it gets
# its own policy instead of the site's.
/slidedeck/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
