# Sanity — Astro app (apps/web)
#
# Copy to apps/web/.env and fill in. These names are the Astro-native PUBLIC_*
# ones; the Next app at the repo root reads the same values (it falls back to
# NEXT_PUBLIC_* for a transition period).

# Required. https://sanity.io/manage → project settings → API
PUBLIC_SANITY_PROJECT_ID=
# Required. This project's dataset is named "badger3000" — NOT "production".
PUBLIC_SANITY_DATASET=badger3000
# Pinned so a Sanity API bump cannot change a deployed build.
PUBLIC_SANITY_API_VERSION=2024-03-09
# The dataset is private (aclMode: private), so every read needs a token. Leave
# off only if you point this at a public dataset.
PUBLIC_SANITY_USE_CDN=false

# Required for a private dataset, and for previewing drafts in development —
# the CDN never serves drafts. Server-only: never ships to the browser. A
# production build needs it too, so set it in Cloudflare's build environment.
SANITY_API_TOKEN=

# Where the site is served from. Used for canonical URLs, feeds and the sitemap.
PUBLIC_SITE_URL=https://badger3000.com
# ---- The agent (/api/chat) -----------------------------------------------
# ADR 0008 planned a Workers AI step that writes one line around the retrieved
# facts. Measured against the live model catalog, a 3B model could not produce a
# single grounded line — every answer was decorated with a claim the facts did
# not support, and the grounding check threw them all away. So the model tier is
# **off by default** and the deterministic phrasing answers instead.
# Set to "on" to try it again, or move MODEL in src/lib/agent/compose.ts to a
# bigger model first.
# CHAT_MODEL_TIER=off
