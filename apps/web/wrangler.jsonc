{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badger3000-web",
  "compatibility_date": "2026-03-01",
  // @astrojs/cloudflare owns "main" and "assets" — the hand-written assets block
  // is gone now that there is a Worker script (ADR 0009, phase 4).
  //
  // Pages stay prerendered (`output: "static"`); /api/chat opts out with
  // `export const prerender = false`. That is the ISR-equivalent: immutable
  // edge-cached assets for content, one invocation for the agent.
  "compatibility_flags": ["nodejs_compat"],

  // The adapter adds the ASSETS binding and directory; this only pins how HTML
  // is matched, which is the platform default, written down because the URL
  // scheme depends on it. Astro writes `projects.html` (build.format "file"),
  // so `/projects` is served and `/projects/` redirects to it. A directory with
  // an index.html (`/slidedeck/giga/`) keeps its slash, so relative links in
  // that page still resolve.
  "assets": { "html_handling": "auto-trailing-slash" },

  // Workers AI — ADR 0008. The one-line "compose" step. The endpoint degrades to
  // deterministic phrasing when this binding is missing, so a free plan is fine.
  "ai": { "binding": "AI" },

  // /api/chat: 20 questions a minute per visitor IP. Every question costs 1–3
  // Sanity reads (and Workers AI if the model tier is on). The endpoint skips
  // limiting when the binding is missing. namespace_id is any account-unique
  // integer string.
  //
  // /api/contact: 5 messages a minute per IP. Each one costs a reCAPTCHA verify
  // and two Resend sends, so the bar is much lower. Skipped when missing, too.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  "observability": { "enabled": true }
}